# Supabase の接続先（ブラウザに渡してよい公開情報だけ。VITE_ で始まる値はアプリ本体に埋め込まれる）
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 初期データ投入・アカウント追加のスクリプトだけが使う管理用の鍵（secret key）。
# VITE_ を絶対に付けない（付けるとアプリ本体に埋め込まれて公開される）。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# 開発サーバーのデモモードで読み込むデータ（省略時は fixtures/sample-data.json の架空データ）
# DEMO_DATA=data/initial-data.json
